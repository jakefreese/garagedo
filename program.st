FUNCTION_BLOCK LIGHT_TOGGLE
  VAR_INPUT
    LTS_IN : BOOL;
    LTS_V : BOOL;
    ALL_ON : BOOL;
    ALL_OFF : BOOL;
  END_VAR
  VAR_OUTPUT
    LT_OUT : BOOL;
  END_VAR
  VAR
    DebounceTimer : TON;
    EdgeTrigger : R_TRIG;
    AnyButton : BOOL;
    Prev_LT : BOOL;
  END_VAR

  (* Combine physical + virtual button *)
  AnyButton := LTS_IN OR LTS_V;

  (* Debounce + rising edge on any button press *)
  DebounceTimer(IN := AnyButton, PT := T#40ms);

  EdgeTrigger(CLK := DebounceTimer.Q);

  (* Toggle on valid button press (40ms confirmed) *)
  IF EdgeTrigger.Q THEN
      LT_OUT := NOT LT_OUT;
  END_IF;

  (* Master ALL_ON - turns ON only if currently OFF *)
  IF ALL_ON AND NOT LT_OUT THEN
      LT_OUT := TRUE;
  END_IF;

  (* Master ALL_OFF - turns OFF only if currently ON *)
  IF ALL_OFF AND LT_OUT THEN
      LT_OUT := FALSE;
  END_IF;

  (* Store previous state if needed for future enhancements *)
  Prev_LT := LT_OUT;
END_FUNCTION_BLOCK

