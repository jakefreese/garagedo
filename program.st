FUNCTION_BLOCK C_F
  VAR_INPUT
    Office_C_in : REAL;
    Garage_C_in : REAL;
    Exterior_C_in : REAL;
    RV_C_in : REAL;
    HVAC_Sup_C_in : REAL;
    HVAC_ret_C_in : REAL;
    HVAC_L_C_in : REAL;
    HVAC_V_C_in : REAL;
  END_VAR
  VAR_OUTPUT
    Office_F_out : REAL;
    Garage_F_out : REAL;
    Exterior_F_out : REAL;
    RV_F_out : REAL;
    HVAC_Sup_F_out : REAL;
    HVAC_ret_F_out : REAL;
    HVAC_L_F_out : REAL;
    HVAC_V_F_out : REAL;
  END_VAR
  VAR
    C_limited1 : REAL;
    C_limited2 : REAL;
    C_limited3 : REAL;
    C_limited4 : REAL;
    C_limited5 : REAL;
    C_limited6 : REAL;
    C_limited7 : REAL;
    C_limited8 : REAL;
  END_VAR

  C_limited1 := LIMIT(-20.0, Office_C_in, 150.0);
  Office_F_out := (C_limited1 * 9.0 / 5.0) + 32.0;

  C_limited2 := LIMIT(-20.0, Garage_C_in, 150.0);
  Garage_F_out := (C_limited2 * 9.0 / 5.0) + 32.0;

  C_limited3 := LIMIT(-20.0, Exterior_C_in, 150.0);
  Exterior_F_out := (C_limited3 * 9.0 / 5.0) + 32.0;

  C_limited4 := LIMIT(-20.0, RV_C_in, 150.0);
  RV_F_out := (C_limited4 * 9.0 / 5.0) + 32.0;

  C_limited5 := LIMIT(-20.0, HVAC_Sup_C_in, 150.0);
  HVAC_Sup_F_out := (C_limited5 * 9.0 / 5.0) + 32.0;

  C_limited6 := LIMIT(-20.0, HVAC_ret_C_in, 150.0);
  HVAC_ret_F_out := (C_limited6 * 9.0 / 5.0) + 32.0;

  C_limited7 := LIMIT(-20.0, HVAC_L_C_in, 150.0);
  HVAC_L_F_out := (C_limited7 * 9.0 / 5.0) + 32.0;

  C_limited8 := LIMIT(-20.0, HVAC_V_C_in, 150.0);
  HVAC_V_F_out := (C_limited8 * 9.0 / 5.0) + 32.0;
END_FUNCTION_BLOCK

