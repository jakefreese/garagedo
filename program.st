FUNCTION_BLOCK DAYRESET
  VAR_INPUT
    RTC_IN : DT;
  END_VAR
  VAR_OUTPUT
    NewDayPulse : BOOL;
  END_VAR
  VAR
    LastDate : DT;
    CurrentDate : DT;
  END_VAR

  (*// Main logic*)
  CurrentDate := RTC_IN;

  IF CurrentDate <> LastDate THEN
      NewDayPulse := TRUE;
      LastDate := CurrentDate;
  ELSE
      NewDayPulse := FALSE;
  END_IF;
END_FUNCTION_BLOCK


