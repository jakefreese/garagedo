// === C2 LED Control - Using Named Properties from Buffer Parser ===
const varName = "C2";   // or whatever name you gave it in the parser

if (msg.payload && typeof msg.payload === "object") {
    const value = msg.payload[varName];
    
    if (value === 1 || value === true || value === "1") {
        return [
            { payload: `C2 = 1 → LED ON` },
            { payload: true }
        ];
    } else {
        return [
            { payload: `C2 = ${value} → LED OFF` },
            { payload: false }
        ];
    }
}

// Fallback
return [null, { payload: false }];
