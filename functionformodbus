// === C2 LED Control - Direct from Modbus Flex (Boolean Array) ===
const coilIndex = 2;   // Change this for each coil:
                       // %QX0.0 → 0
                       // %QX0.1 → 1  
                       // %QX0.2 → 2   ← your working one

let value = false;
if (Array.isArray(msg.payload)) {
    value = Boolean(msg.payload[coilIndex]);
}

if (value) {
    return [
        { payload: `C2 (index ${coilIndex}) ON` },   // Debug output
        { payload: true }                            // To ui-led / other nodes
    ];
} else {
    return [
        { payload: `C2 (index ${coilIndex}) OFF` },
        { payload: false }
    ];
}
