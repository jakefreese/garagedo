FUNCTION_BLOCK LIGHTING
  VAR_INPUT
    OFFICE_IN : BOOL;
    HOBBY_IN : BOOL;
    LAUNDRY_IN : BOOL;
    CALLIE_IN : BOOL;
    TRAVIS_IN : BOOL;
    GARAGE_IN : BOOL;
    FF_IN : BOOL;
  END_VAR
  VAR_OUTPUT
    OFFICE_OUT : BOOL;
    HOBBY_OUT : BOOL;
    LAUNDRY_OUT : BOOL;
    CALLIE_OUT : BOOL;
    TRAVIS_OUT : BOOL;
    GARAGE_OUT : BOOL;
    FF_OUT : BOOL;
  END_VAR
  VAR
    DB : TIME := T#500ms;
    TON0 : TON;
    TON1 : TON;
    TON2 : TON;
    TON3 : TON;
    TON4 : TON;
    TON5 : TON;
    TON6 : TON;
  END_VAR

  TON0(IN := OFFICE_IN, PT := DB);
  OFFICE_OUT := TON0.Q;
  TON1(IN := HOBBY_IN, PT := DB);
  HOBBY_OUT := TON1.Q;
  TON2(IN := LAUNDRY_IN, PT := DB);
  LAUNDRY_OUT := TON2.Q;
  TON3(IN := CALLIE_IN, PT := DB);
  CALLIE_OUT := TON3.Q;
  TON4(IN := TRAVIS_IN, PT := DB);
  OFFICE_OUT := TON4.Q;
  TON5(IN := GARAGE_IN, PT := DB);
  GARAGE_OUT := TON5.Q;
  TON6(IN := FF_IN, PT := DB);
  FF_OUT := TON6.Q;
END_FUNCTION_BLOCK

FUNCTION_BLOCK WELL
  VAR_INPUT
    PS : BOOL;
  END_VAR
  VAR_OUTPUT
    WELLPUMP1 : BOOL;
  END_VAR
  VAR
    PSDB : TIME := T#1s;
    RRDELAY : TIME := T#30s;
    RRDELAY0 : BOOL;
    TON0 : TON;
    TOF0 : TOF;
    F_TRIG1 : F_TRIG;
  END_VAR

  TON0(IN := PS, PT := PSDB);
  WELLPUMP1 := NOT(RRDELAY0) AND TON0.Q;
  F_TRIG1(CLK := WELLPUMP1);
  TOF0(IN := F_TRIG1.Q, PT := RRDELAY);
  RRDELAY0 := TOF0.Q;
END_FUNCTION_BLOCK

FUNCTION_BLOCK SEPTIC
  VAR_INPUT
    SEPTIC_CTL_IN : BOOL;
    SEPTIC_H_IN : BOOL;
  END_VAR
  VAR_OUTPUT
    SEPTIC_HIGH : BOOL;
    SEPTIC_PUMP_OUT : BOOL;
  END_VAR
  VAR
    SEPTIC_DB : TIME := T#30s;
    TON0 : TON;
    SEPTIC_PUMP : BOOL;
    TOF0 : TOF;
    RERUNDELAY : TIME := T#5m;
    RERUNDELAY0 : BOOL;
    TON1 : TON;
    F_TRIG1 : F_TRIG;
  END_VAR

  TON0(IN := SEPTIC_CTL_IN, PT := SEPTIC_DB);
  SEPTIC_PUMP_OUT := NOT(RERUNDELAY0) AND TON0.Q;
  F_TRIG1(CLK := SEPTIC_PUMP_OUT);
  TOF0(IN := F_TRIG1.Q, PT := RERUNDELAY);
  RERUNDELAY0 := TOF0.Q;
  TON1(IN := SEPTIC_H_IN, PT := SEPTIC_DB);
  SEPTIC_HIGH := TON1.Q;
END_FUNCTION_BLOCK

PROGRAM GARAGE_LD
