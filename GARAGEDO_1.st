    TRAVIS_LT AT %QX0.5 : BOOL := 0;
    GARAGE_LT AT %QX0.6 : BOOL := 0;
    FF_LT AT %QX0.7 : BOOL := 0;
    SEPTIC_PUMP AT %QX0.8 : BOOL := 0;
