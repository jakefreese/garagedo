// === Monitor C1 and control UI LED ===
const varName = "C1";      // Change if you want to monitor another variable

if (msg.payload && typeof msg.payload === "object") {
    
    const value = msg.payload[varName];
    
    if (value === 1) {
        // Turn LED ON
        node.send([
            { payload: "C1 is ACTIVE (1)", topic: "C1" },   // Output 1 → Debug node
            { payload: true }                                // Output 2 → UI LED
        ]);
    } 
    else {
        // Turn LED OFF
        node.send([
            { payload: `C1 = ${value}`, topic: "C1" },      // Output 1 → Debug (optional)
            { payload: false }                               // Output 2 → UI LED
        ]);
    }
    
} else {
    // Safety: turn LED off if payload is invalid
    node.send([null, { payload: false }]);
}
