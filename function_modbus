// === Simple & Reliable LED control for C1 ===
const varName = "C1";

if (msg.payload && typeof msg.payload === "object") {
    
    let value = msg.payload[varName];
    
    // In case the value comes as string "1"
    if (value === "1" || value === 1) {
        return [ 
            { payload: "C1 is ON" },     // Output 1 → Debug
            { payload: true }            // Output 2 → UI LED (ON)
        ];
    } else {
        return [ 
            { payload: `C1 = ${value}` }, 
            { payload: false }           // Output 2 → UI LED (OFF)
        ];
    }
    
} else {
    // Safety fallback
    return [ null, { payload: false } ];
}
